<style>
/* ─── NEWSLETTER.HTML — styles spécifiques ─── */

.forge-hero{
  padding:72px 0 80px;
  background:var(--lin);
  border-bottom:1px solid var(--chene-25);
}
.forge-badge{
  display:inline-flex;align-items:center;gap:10px;
  font-family:var(--ff-mono);font-size:11px;letter-spacing:.18em;text-transform:uppercase;
  color:var(--mousse);border:1px solid var(--mousse);
  padding:6px 14px;margin-bottom:32px;
}
.forge-badge::before{
  content:"";width:8px;height:8px;border-radius:50%;
  background:var(--mousse);animation:pulse-forge 2s ease-in-out infinite;
}
@keyframes pulse-forge{0%,100%{opacity:1}50%{opacity:.3}}
.forge-hero h1{
  font-size:clamp(3.2rem,7vw,6rem);line-height:.9;margin-bottom:28px;
}
.forge-hero h1 em{font-family:var(--ff-display);font-style:italic;color:var(--chene)}
.forge-hero h1 .sub{
  display:block;font-family:var(--ff-mono);font-size:clamp(.8rem,1.5vw,1rem);
  font-weight:400;letter-spacing:.14em;text-transform:uppercase;
  color:var(--chene);margin-top:16px;
}
.forge-lede{
  font-size:1.2rem;line-height:1.6;color:var(--ebene-80);
  max-width:50ch;margin-bottom:36px;
}
.forge-meta-row{
  display:flex;align-items:center;gap:28px;flex-wrap:wrap;
  font-family:var(--ff-mono);font-size:11px;color:var(--chene);
  letter-spacing:.1em;margin-top:24px;
  padding-top:24px;border-top:1px dashed var(--chene-25);
}
.forge-meta-row span::before{content:"— ";}

/* Piliers */
.piliers-grid{
  display:grid;grid-template-columns:repeat(3,1fr);gap:24px;
}
.pilier-card{
  background:var(--parchemin);border:1px solid var(--chene-25);
  padding:28px 24px 24px;position:relative;
}
.pilier-numero{
  position:absolute;top:16px;right:18px;
  font-family:var(--ff-mono);font-size:10px;color:var(--chene-25);
  letter-spacing:.12em;
}
.pilier-icon{font-size:1.8rem;margin-bottom:14px;display:block}
.pilier-card h3{font-size:1.15rem;margin-bottom:10px}
.pilier-card p{font-size:.9rem;color:var(--ebene-80);line-height:1.55;margin:0}
.pilier-exemple{
  margin-top:14px;padding:10px 12px;
  background:var(--lin);border-left:2px solid var(--mousse);
  font-family:var(--ff-mono);font-size:11px;color:var(--ebene-80);
  line-height:1.5;
}

/* Pourquoi / Pourquoi pas */
.deux-colonnes{display:grid;grid-template-columns:1fr 1fr;gap:48px}
.raison-oui,.raison-non{padding:32px}
.raison-oui{background:var(--parchemin);border:1px solid var(--mousse);border-radius:var(--r-md)}
.raison-non{background:var(--lin);border:1px dashed var(--chene-25);border-radius:var(--r-md)}
.raison-titre{
  font-family:var(--ff-mono);font-size:11px;letter-spacing:.16em;text-transform:uppercase;
  margin-bottom:20px;
}
.raison-oui .raison-titre{color:var(--mousse)}
.raison-non .raison-titre{color:var(--chene)}
.raison-liste{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px}
.raison-liste li{
  font-size:.92rem;line-height:1.5;color:var(--ebene-80);
  padding-left:20px;position:relative;
}
.raison-oui .raison-liste li::before{content:"✓";position:absolute;left:0;color:var(--mousse);font-weight:700}
.raison-non .raison-liste li::before{content:"✕";position:absolute;left:0;color:var(--pierre);font-weight:700}

/* Formulaire */
.forge-form-wrap{
  max-width:600px;margin:0 auto;
  background:var(--parchemin);border:1px solid var(--chene-25);
  padding:44px 40px;position:relative;
  box-shadow:0 16px 40px -20px rgba(44,40,37,.18),
             12px 12px 0 -3px var(--kraft),
             12px 12px 0 -2px var(--chene-25);
}
.forge-form-stamp{
  position:absolute;top:20px;right:28px;
  font-family:var(--ff-mono);font-size:9px;letter-spacing:.16em;text-transform:uppercase;
  color:var(--mousse);border:2px solid var(--mousse);padding:5px 9px;
  transform:rotate(3deg);opacity:.7;
}
.forge-form-label-top{
  font-family:var(--ff-mono);font-size:11px;color:var(--chene);
  letter-spacing:.14em;text-transform:uppercase;
  margin-bottom:24px;padding-bottom:14px;border-bottom:1px dashed var(--chene-25);
}
.forge-form-wrap .field{margin-bottom:18px}
.forge-form-wrap label{
  display:block;font-family:var(--ff-mono);font-size:11px;
  letter-spacing:.1em;text-transform:uppercase;color:var(--chene);
  margin-bottom:6px;
}
.forge-form-wrap input[type="email"]{
  width:100%;padding:12px 14px;
  background:var(--lin);border:1px solid var(--chene-25);
  font-family:var(--ff-body);font-size:15px;color:var(--ebene);
  border-radius:var(--r-sm);outline:none;
  transition:border-color .2s;
}
.forge-form-wrap input[type="email"]:focus{border-color:var(--chene)}
.forge-checkbox-row{
  display:flex;align-items:flex-start;gap:12px;
  margin-top:16px;padding-top:16px;border-top:1px dashed var(--chene-25);
}
.forge-checkbox-row input[type="checkbox"]{
  width:18px;height:18px;flex-shrink:0;margin-top:2px;cursor:pointer;
  accent-color:var(--mousse);
}
.forge-checkbox-row label{
  font-family:var(--ff-body);font-size:.85rem;color:var(--ebene-80);
  line-height:1.5;letter-spacing:0;text-transform:none;margin:0;
}
.forge-activation-notice{
  margin-top:20px;padding:12px 16px;
  background:rgba(138,117,96,.08);border:1px dashed var(--chene-25);
  font-family:var(--ff-mono);font-size:11px;color:var(--chene);
  letter-spacing:.06em;line-height:1.6;text-align:center;
}

/* Échantillon */
.echantillon-card{
  background:var(--parchemin);border:1px solid var(--chene-25);
  padding:32px 28px;
  position:relative;
}
.echantillon-header{
  display:flex;align-items:center;justify-content:space-between;
  margin-bottom:24px;padding-bottom:14px;border-bottom:1px solid var(--chene-25);
}
.echantillon-numero{
  font-family:var(--ff-mono);font-size:10px;color:var(--chene);
  letter-spacing:.18em;text-transform:uppercase;
}
.echantillon-date{
  font-family:var(--ff-mono);font-size:10px;color:var(--pierre);
  letter-spacing:.1em;
}
.echantillon-bloc{margin-bottom:20px;padding-bottom:20px;border-bottom:1px dashed var(--chene-25)}
.echantillon-bloc:last-child{margin-bottom:0;padding-bottom:0;border-bottom:none}
.echantillon-tag{
  font-family:var(--ff-mono);font-size:10px;letter-spacing:.16em;text-transform:uppercase;
  color:var(--mousse);margin-bottom:8px;
}
.echantillon-bloc h4{font-size:1rem;margin-bottom:6px}
.echantillon-bloc p{font-size:.88rem;color:var(--ebene-80);line-height:1.55;margin:0}

/* FAQ */
.faq-forge-item{
  border-bottom:1px dashed var(--chene-25);padding:20px 0;
}
.faq-forge-item:last-child{border-bottom:none}
.faq-forge-q{
  font-family:var(--ff-display);font-weight:600;
  font-size:1.05rem;margin-bottom:8px;color:var(--ebene);
}
.faq-forge-a{font-size:.92rem;color:var(--ebene-80);line-height:1.6;margin:0}

/* Engagement strip */
.engagement-strip{
  background:var(--ebene);color:var(--lin);
  padding:48px 0;
}
.engagement-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;text-align:center}
.engagement-item .num{
  font-family:var(--ff-display);font-size:3rem;color:var(--chene);
  display:block;margin-bottom:8px;
}
.engagement-item p{font-size:.88rem;color:rgba(242,237,232,.7);margin:0;line-height:1.5}

/* Responsive */
@media(max-width:880px){
  .piliers-grid{grid-template-columns:1fr}
  .deux-colonnes{grid-template-columns:1fr;gap:24px}
  .engagement-grid{grid-template-columns:1fr;gap:32px}
  .forge-form-wrap{padding:28px 22px}
}
</style>
</head>
